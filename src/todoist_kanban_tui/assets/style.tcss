Screen {
    layout: vertical;
}

/* Header */
#app-header {
    dock: top;
    height: 3;
    background: $primary-background-darken-1;
    content-align: center middle;
    text-style: bold;
    padding: 1 2;
    color: $text;
}

/* Board */
KanbanBoard {
    width: 1fr;
    height: 1fr;
}

/* Columns */
SectionColumn {
    height: 1fr;
    border-right: vkey $surface-lighten-1;
}

SectionColumn .column-header {
    width: 1fr;
    text-align: center;
    text-style: bold;
    background: $accent-muted;
    color: $text;
    padding: 1 1;
    border-bottom: heavy $accent;
}

SectionColumn .column-scroll {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* Task Cards */
TaskCard {
    width: 1fr;
    height: auto;
    min-height: 3;
    max-height: 20;
    margin: 1 0 0 0;
    padding: 0 1;
    background: $surface;
    border: round $surface-lighten-2;
}

TaskCard:focus {
    border: round $accent;
    background: $surface-lighten-1;
}

/* Priority borders */
TaskCard.priority-4 {
    border-left: thick $error;
}

TaskCard.priority-3 {
    border-left: thick $warning;
}

TaskCard.priority-2 {
    border-left: thick $accent;
}

/* Overdue */
TaskCard.overdue {
    color: $error;
}

/* Lifted card */
TaskCard.lifted {
    border: double $warning;
    background: $warning 15%;
    text-style: bold;
}

/* Drop target column */
SectionColumn.drop-target .column-header {
    background: $warning-muted;
    text-style: bold italic;
}

SectionColumn.drop-target {
    border-right: vkey $warning;
}

/* Empty board */
#empty-board {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
}

/* Status Bar */
StatusBar {
    dock: bottom;
    height: 1;
    background: $primary-background-darken-2;
    color: $text-muted;
    padding: 0 2;
}

/* Scrollbars */
* {
    scrollbar-size-vertical: 1;
    scrollbar-color: $surface-lighten-2;
    scrollbar-color-active: $accent;
    scrollbar-color-hover: $primary;
}

/* Project Picker */
#picker-title {
    width: 1fr;
    height: 3;
    text-align: center;
    text-style: bold;
    padding: 1;
    color: $text;
}

#project-list {
    width: 60%;
    height: 1fr;
    margin: 0 20;
}
